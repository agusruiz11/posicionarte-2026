# Copiá este archivo a .env.local y completá los valores.
# .env.local está en .gitignore: nunca subas claves al repo.

# ── Resend ────────────────────────────────────────────────────────────────
# Manda los mails de los formularios. Se genera en https://resend.com/api-keys
# Sin esta clave el sitio compila y navega igual, pero los formularios fallan
# al enviar (la instancia de Resend se crea perezosamente, no en el import).
RESEND_API_KEY=

# Casilla donde caen los leads. Acepta varias separadas por coma.
# Para probar sin ensuciar la casilla real: delivered@resend.dev
LEAD_EMAIL=agencia@posicionarte.online

# Audiencia de Resend para la secuencia post-descarga del benchmark.
# El ID es el UUID que aparece en la URL al abrir la audiencia:
#   resend.com/audiences/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
# Sin esto el formulario funciona igual, solo que nadie se suma a la lista.
RESEND_AUDIENCE_ID=

# Key aparte, con acceso completo, SOLO para dar de alta contactos.
# El key de arriba es de envío solamente y con ese permiso `contacts.create`
# devuelve 401. Resend no tiene un permiso intermedio: o manda mails, o tiene
# acceso completo. Con dos keys, el que se usa en cada formulario sigue sin
# poder leer nada. Si dejás esto vacío se usa RESEND_API_KEY.
RESEND_AUDIENCE_API_KEY=

# ── Google Tag Manager ────────────────────────────────────────────────────
# ID del contenedor. Sin esto no se carga ningún script de terceros y los
# eventos quedan solo en el dataLayer: así se puede desarrollar y hacer
# preview sin ensuciar los datos de producción.
# Ojo: es NEXT_PUBLIC_, se inlinea en tiempo de build. Cambiarla en Vercel
# no tiene efecto hasta el próximo deploy.
NEXT_PUBLIC_GTM_ID=

# ── Base del CRM ──────────────────────────────────────────────────────────
# Donde se guardan los leads. La clave es la ANÓNIMA (publicable), no la
# service role: lo único que habilita es llamar a public.insert_lead(), que
# crea un lead y nada más. No puede leer los leads ni tocar el resto del CRM.
# Se copian de Supabase > Project Settings > API.
# Sin estas dos variables el lead igual llega por mail; solo no queda historial.
CRM_SUPABASE_URL=
CRM_SUPABASE_ANON_KEY=
